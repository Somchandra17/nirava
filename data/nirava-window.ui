<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.6"/>
  <object class="AdwApplicationWindow" id="window">
    <property name="title">Nirava</property>
    <property name="default-width">1050</property>
    <property name="default-height">760</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 650sp</condition>
        <setter object="split" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwNavigationSplitView" id="split">
        <property name="min-sidebar-width">220</property>
        <property name="max-sidebar-width">280</property>
        <property name="sidebar">
          <object class="AdwNavigationPage">
            <property name="title">Settings</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-end-title-buttons">False</property>
                    <property name="title-widget">
                      <object class="AdwWindowTitle">
                        <property name="title">Nirava</property>
                        <property name="subtitle">Desktop settings</property>
                      </object>
                    </property>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <child><object class="GtkSearchEntry" id="search"><property name="placeholder-text">Search settings</property></object></child>
                    <child>
                      <object class="GtkListBox" id="navigation">
                        <property name="selection-mode">single</property>
                        <style><class name="navigation-sidebar"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Displays, sound, power and apps for your desktop.</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">12</property>
                        <style><class name="dim-label"/><class name="caption"/></style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <object class="AdwNavigationPage" id="content_page">
            <property name="title">Displays</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar"><property name="show-start-title-buttons">False</property></object>
                </child>
                <property name="content">
                  <object class="AdwToastOverlay" id="toasts">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="AdwBanner" id="banner">
                            <property name="title">Read-only preview — desktop configuration is unchanged</property>
                            <property name="revealed">True</property>
                          </object>
                        </child>
                        <child><object class="GtkStack" id="pages"><property name="vexpand">True</property></object></child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
