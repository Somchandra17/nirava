[Unit]
Description=Nirava desktop settings backend (read-only)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.Somchandra17.Nirava.Session
ExecStart=/usr/bin/nirava-sessiond
Restart=on-failure
RestartSec=1
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
